{
  "expo": {
    "name": "Quran-Track",
    "slug": "Quran-Track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/quran-track.png",
    "scheme": "qurantrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hebasamir.qurantrack",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/quran-track.png",
        "backgroundImage": "./assets/images/quran-track.png",
        "monochromeImage": ".assets/images/quran-track.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "assets/images/quran-splash.png",
          "imageWidth": 420,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F2",
          "dark": {
            "backgroundColor": "#1E293B"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8cd1a28e-884e-40a9-ab8a-47076dea28bf"
      }
    }
  }
}
